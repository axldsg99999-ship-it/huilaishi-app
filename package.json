{
  "name": "huilaishi-app",
  "version": "12.6.3",
  "private": true,
  "type": "module",
  "description": "萨瓦迪卡中泰双向语言学习 PWA 的零依赖质量门禁",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:vocab-inventory": "node scripts/validate-vocab-inventory.mjs",
    "validate:lexicon-review": "node scripts/validate-lexicon-review.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:store": "node scripts/validate-store-readiness.mjs",
    "validate:store:strict": "node scripts/validate-store-readiness.mjs --strict",
    "check": "npm run test && npm run validate:content && npm run validate:vocab-inventory && npm run validate:lexicon-review && npm run validate:release && npm run validate:store"
  },
  "engines": {
    "node": ">=20"
  }
}
